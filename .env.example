# Database used by backend and sweep worker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tonhub_payments?schema=public"

# Public API defaults.
TONHUB_PAYMENTS_PORT=3008
TONHUB_CORS_ORIGIN="http://localhost:5173"
VITE_TONCONNECT_MANIFEST_URL=
TON_DEFAULT_NETWORK=testnet
TON_ALLOWED_NETWORKS=testnet,mainnet
TON_INVOICE_REFERENCE_PREFIX=TONHUB
TON_INVOICE_TTL_MINUTES=60
TON_PARTIAL_PAYMENT_TTL_HOURS=24
# Full merchant network cost in fiat micros; initial partial requires max(50%, 2x the matching currency value).
TON_PARTIAL_MERCHANT_NETWORK_FEE_USD_MICROS=0
TON_PARTIAL_MERCHANT_NETWORK_FEE_EUR_MICROS=0
TON_RATE_SNAPSHOT_INTERVAL_SECONDS=60
TON_RATE_SNAPSHOT_MAX_AGE_SECONDS=300
# Use all in production so native GRAM sent to a mainnet USDT checkout is still discovered.
TON_GRAM_SHADOW_NETWORK=all
TON_GRAM_SHADOW_INTERVAL_SECONDS=15
TON_GRAM_SHADOW_BATCH_SIZE=20
TON_GRAM_SHADOW_TERMINAL_INTERVAL_SECONDS=86400
TON_GRAM_SHADOW_TERMINAL_MONITOR_DAYS=30
TON_GRAM_SHADOW_RETRY_SECONDS=60
TON_GRAM_SHADOW_LEASE_SECONDS=60
TON_GRAM_SHADOW_PAGE_SIZE=100
TON_GRAM_SHADOW_MAX_PAGES=100
# Internal QA only. This master is mapped to USDT-shaped 6-decimal ledger evidence on testnet.
# It is never exposed as a public checkout asset and cannot be configured for mainnet.
TON_INTERNAL_TESTNET_JETTON_ENABLED=false
TON_INTERNAL_TESTNET_JETTON_NETWORK=testnet
TON_INTERNAL_TESTNET_JETTON_MASTER_ADDRESS=
TON_INTERNAL_TESTNET_JETTON_DECIMALS=6
# Official USDT on TON mainnet only. The master identity is compiled into the adapter.
TON_USDT_MAINNET_ADAPTER_ENABLED=false
# Public checkout stays GRAM-only unless this flag, the mainnet adapter, and movement settlement are all enabled.
TON_USDT_MAINNET_CHECKOUT_ENABLED=false
TON_USDT_MAINNET_SCAN_INTERVAL_SECONDS=15
TON_USDT_MAINNET_SCAN_BATCH_SIZE=20
TON_USDT_MAINNET_SCAN_TERMINAL_INTERVAL_SECONDS=86400
TON_USDT_MAINNET_SCAN_TERMINAL_MONITOR_DAYS=30
TON_USDT_MAINNET_SCAN_RETRY_SECONDS=60
TON_USDT_MAINNET_SCAN_LEASE_SECONDS=60
TON_USDT_MAINNET_SCAN_PAGE_SIZE=1000
TON_USDT_MAINNET_SCAN_MAX_PAGES=100
# Re-read the last hour to tolerate delayed provider indexing; ledger fingerprints deduplicate it.
TON_USDT_MAINNET_SCAN_OVERLAP_SECONDS=3600
TON_USDT_MAINNET_SCAN_CANDIDATE_POOL_SIZE=10000
# Worker-only USDT sweep. The gas-service V5R1 address must equal the mainnet sweep recipient.
TON_MAINNET_GAS_SERVICE_SECRET_KEY=
TON_MAINNET_USDT_GAS_TARGET_NANO=150000000
TON_MAINNET_USDT_DEPOSIT_RESERVE_NANO=50000000
TON_MAINNET_USDT_TRANSFER_VALUE_NANO=50000000
TON_MAINNET_USDT_WALLET_FEE_CUSHION_NANO=50000000
TON_MAINNET_USDT_SWEEP_INTERVAL_SECONDS=5
TON_MAINNET_USDT_SWEEP_BATCH_SIZE=20
TON_MAINNET_USDT_SWEEP_RETRY_SECONDS=60
TON_MAINNET_USDT_SWEEP_LEASE_SECONDS=60
TON_MAINNET_USDT_SWEEP_CONFIRMATION_GRACE_SECONDS=300
TON_MAINNET_USDT_SWEEP_MAX_ATTEMPTS=10
# ledger = strict production source; compare = legacy response + structured diff; legacy = rollback.
TON_GRAM_SETTLEMENT_MODE=ledger
# Enables fiat-allocation settlement only for new invoices with a non-zero activation policy.
TON_MOVEMENT_SETTLEMENT_ENABLED=false
TON_MOVEMENT_SETTLEMENT_INTERVAL_SECONDS=15
TON_MOVEMENT_SETTLEMENT_BATCH_SIZE=100
TON_MOVEMENT_SETTLEMENT_RETRY_SECONDS=60

# TON Center API keys. Testnet and mainnet can use separate keys.
TON_TESTNET_API_KEY=
TON_MAINNET_API_KEY=

# Public keys used by the backend to derive one V5R1 deposit wallet per invoice.
# Use the matching secret keys only in the worker environment, not in web/API.
TON_TESTNET_DEPOSIT_PUBLIC_KEY=
TON_MAINNET_DEPOSIT_PUBLIC_KEY=
TON_DEPOSIT_WALLET_WORKCHAIN=0

# Worker-only signing credentials for sweeping paid deposit wallets. Never expose them to the API.
TON_TESTNET_DEPOSIT_SECRET_KEY=
TON_MAINNET_DEPOSIT_SECRET_KEY=
TON_TESTNET_SWEEP_RECIPIENT_ADDRESS=
TON_MAINNET_SWEEP_RECIPIENT_ADDRESS=
TON_SWEEP_RESERVE_NANO=50000000
TON_SWEEP_MIN_NANO=1000000
TON_SWEEP_NETWORK=testnet

# Frontend demo defaults.
VITE_TONHUB_PAYMENTS_API_BASE="/api/tonhub-payments"
VITE_TONHUB_PAYMENTS_DEFAULT_NETWORK=testnet

